# =============================================================================
# RNR Financial Analysis Platform - Root .env.example
# Copy to .env and replace every value. Generate secrets with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# =============================================================================

# -----------------------------------------------------------------------------
# Environment
# -----------------------------------------------------------------------------
ENVIRONMENT=development            # development | staging | production
DEBUG=true                         # set to false in staging / production

# -----------------------------------------------------------------------------
# Application security (REQUIRED — backend will fail to start without these)
# -----------------------------------------------------------------------------
SECRET_KEY=GENERATE_WITH_secrets.token_urlsafe_32
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# -----------------------------------------------------------------------------
# Database (PostgreSQL + optional TimescaleDB)
# -----------------------------------------------------------------------------
POSTGRES_DB=financial_analysis
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME_STRONG_DB_PASSWORD
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://postgres:CHANGE_ME_STRONG_DB_PASSWORD@localhost:5432/financial_analysis

# -----------------------------------------------------------------------------
# Redis
# -----------------------------------------------------------------------------
REDIS_PASSWORD=CHANGE_ME_STRONG_REDIS_PASSWORD
REDIS_PORT=6379
REDIS_URL=redis://:CHANGE_ME_STRONG_REDIS_PASSWORD@localhost:6379/0

# -----------------------------------------------------------------------------
# Web ports
# -----------------------------------------------------------------------------
BACKEND_PORT=8000
FRONTEND_PORT=3030
HTTP_PORT=80
HTTPS_PORT=443

# -----------------------------------------------------------------------------
# CORS — set to your real frontend origin(s) in staging/production
# -----------------------------------------------------------------------------
BACKEND_CORS_ORIGINS=["http://localhost:3030","http://localhost:5173"]

# -----------------------------------------------------------------------------
# External Market Data APIs (all OPTIONAL — leave blank to disable feature)
# -----------------------------------------------------------------------------
ALPHA_VANTAGE_API_KEY=
FINNHUB_API_KEY=
POLYGON_API_KEY=
TWELVE_DATA_API_KEY=
NASDAQ_DATA_API_KEY=
FINANCIAL_MODELING_PREP_API_KEY=
IEX_API_KEY=
NEWSAPI_KEY=
# yfinance (Yahoo) — UNLICENSED for commercial use (Yahoo TOS). Keep true for
# local/research; set false in production / MAS-regulated deployments and rely
# on the licensed keys above.
YFINANCE_ENABLED=true

# -----------------------------------------------------------------------------
# Interactive Brokers (IBKR) Paper Trading
# Required ONLY if you enable the /api/v1/ibkr/ endpoints.
# Start TWS in Paper Trading mode and enable "Enable ActiveX and Socket Clients"
# in Global Configuration > API > Settings. Default paper port: 7497.
# -----------------------------------------------------------------------------
IBKR_ENABLED=false
IBKR_HOST=127.0.0.1
IBKR_PORT=7497                     # 7497=TWS paper, 7496=TWS live, 4002=Gateway paper, 4001=Gateway live
IBKR_CLIENT_ID=42                  # any int 1-32; must be unique per concurrent connection
IBKR_ACCOUNT_ID=                   # e.g. DU1234567 (your paper account); leave blank to use the master account
IBKR_READONLY=true                 # true blocks order placement; flip to false ONLY when you trust the integration
IBKR_RECONNECT_DELAY_SECONDS=5
IBKR_MAX_RECONNECT_ATTEMPTS=10
IBKR_ORDER_DAILY_LIMIT=50          # safety brake: max orders per user per UTC day
IBKR_ORDER_NOTIONAL_LIMIT_USD=100000

# -----------------------------------------------------------------------------
# Billing (Stripe) — leave blank to disable
# -----------------------------------------------------------------------------
STRIPE_API_KEY=
STRIPE_WEBHOOK_SECRET=

# -----------------------------------------------------------------------------
# Email (SMTP) — leave blank to disable
# -----------------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_TLS=true
EMAIL_FROM=

# -----------------------------------------------------------------------------
# Monitoring / Observability
# -----------------------------------------------------------------------------
SENTRY_DSN=
LOG_LEVEL=INFO
LOG_FILE=

# -----------------------------------------------------------------------------
# Rate limits (per minute)
# -----------------------------------------------------------------------------
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_BURST=10
AUTH_RATE_LIMIT_PER_MINUTE=10
DATA_RATE_LIMIT_PER_MINUTE=100

# -----------------------------------------------------------------------------
# Account lockout
# -----------------------------------------------------------------------------
MAX_LOGIN_ATTEMPTS=5
ACCOUNT_LOCKOUT_MINUTES=30

# -----------------------------------------------------------------------------
# SSL / TLS (production)
# -----------------------------------------------------------------------------
SSL_CERT_FILE=
SSL_KEY_FILE=
FORCE_HTTPS=false
