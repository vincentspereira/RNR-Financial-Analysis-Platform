# Database Configuration
DATABASE_URL=postgresql://username:password@localhost:5432/financial_analysis_dev
TEST_DATABASE_URL=postgresql://username:password@localhost:5432/financial_analysis_test

# Redis Configuration
REDIS_URL=redis://localhost:6379/0

# Security
SECRET_KEY=your-super-secret-key-change-this-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# External APIs
ALPHA_VANTAGE_API_KEY=your-alpha-vantage-api-key
FINANCIAL_MODELING_PREP_API_KEY=your-fmp-api-key

# Development Settings
DEBUG=True
LOG_LEVEL=DEBUG
ENVIRONMENT=development

# Application Settings
API_V1_STR=/api/v1
PROJECT_NAME=RNR Financial Analysis Platform
VERSION=1.0.0

# CORS Settings
BACKEND_CORS_ORIGINS=["http://localhost:3030","http://localhost:8080","http://localhost:5173"]

# Email Settings (for future use)
SMTP_TLS=True
SMTP_PORT=587
SMTP_HOST="smtp.gmail.com"
SMTP_USER="your-email@gmail.com"
SMTP_PASSWORD="your-app-password"

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60

# Cache Settings
CACHE_EXPIRE_SECONDS=3600

# Task Queue Settings
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2